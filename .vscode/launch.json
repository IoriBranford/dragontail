{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "mapfile",
            "type": "promptString",
            "description": "The map file"
        }
    ],
    "configurations": [
        {
            "name": "Debug",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["${workspaceFolder}/game", "--debug", "--drawstats"]
        },
        {
            "name": "Debug map...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["${workspaceFolder}/game", "--debug", "--drawstats", "--map", "${input:mapfile}"]
        },
        {
            "name": "Profile",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["${workspaceFolder}/game", "--profile", "--drawstats"]
        },
        {
            "name": "Release",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["${workspaceFolder}/game"]
        },
        {
            "name": "OBS Game Capture",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "obs-gamecapture"
            },
            "args": ["love", "${workspaceFolder}/game"]
        },
        {
            "name": "With unit tests",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["${workspaceFolder}/game", "--debug", "--cute"]
        }
    ]
}