{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "mapname",
            "type": "promptString",
            "description": "The map file name only, without data/ or .lua"
        },
        {
            "id": "roomname",
            "type": "promptString",
            "description": "The room in the map"
        }
    ],
    "configurations": [
        {
            "name": "Run",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["game", "--fused"]
        },
        {
            "name": "Run map...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["game", "--fused", "--map", "data/${input:mapname}.lua"]
        },
        {
            "name": "Debug",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["game", "--fused"],
            "args": ["game", "--fused", "--debug", "--drawstats"]
        },
        {
            "name": "Debug map...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["game", "--fused"],
            "args": ["game", "--fused", "--debug", "--drawstats", "--map", "data/${input:mapname}.lua"]
        },
        {
            "name": "Debug room...",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["game", "--fused"],
            "args": ["game", "--fused", "--debug", "--drawstats", "--map", "data/${input:mapname}.lua", "--room", "${input:roomname}"]
        },
        {
            "name": "Profile",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": ["game", "--fused", "--profile", "--drawstats"]
        },
        {
            "name": "OBS Game Capture",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "obs-gamecapture"
            },
            "env": {
                "SDL_VIDEODRIVER": "x11"
            },
            "args": ["love", "game", "--fused"]
        },
        {
            "name": "OBS Game Capture map",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "obs-gamecapture"
            },
            "env": {
                "SDL_VIDEODRIVER": "x11"
            },
            "args": ["love", "game", "--fused", "--map", "data/${input:mapname}.lua"]
        },
        {
            "name": "OBS Game Capture room",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "obs-gamecapture"
            },
            "env": {
                "SDL_VIDEODRIVER": "x11"
            },
            "args": ["love", "game", "--fused", "--map", "data/${input:mapname}.lua", "--room", "${input:roomname}"]
        },
        {
            "name": "With unit tests",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "scriptRoots": ["game", "--fused"],
            "args": ["game", "--fused", "--debug", "--cute"]
        }
    ]
}