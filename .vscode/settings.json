{
    "workbench.colorTheme": "Red",
    "files.associations": {
        "*.tsx": "xml"
    },
    "Lua.workspace.checkThirdParty": false,
    "Lua.workspace.useGitIgnore": false,
    "Lua.workspace.library": [
        "${addons}/love2d/module/library",
        "${addons}/lldebugger/module/library",
        "${addons}/penlight/module/library",
        "${3rd}/lfs/library",
        "${addons}/luafilesystem/module/library"
    ],
    "Lua.runtime.version": "LuaJIT",
    "Lua.runtime.path": [
        "game/libraries/?.lua",
        "game/libraries/?/init.lua",
        "game/code/?.lua",
        "game/code/?/init.lua"
    ],
    "Lua.workspace.ignoreDir": [
        ".vscode",
        "game/data"
    ],
    "Lua.diagnostics.globals": [
        "class",
        "pooledclass",
        "lfs"
    ],
    "Lua.workspace.ignoreSubmodules": false,
    "Lua.runtime.special": {
        "love.filesystem.load": "loadfile"
    }
}